<?xml version="1.0"?>
<root BTCPP_format="4">
    <BehaviorTree ID="VisionPickPlace">
        <Sequence name="pick_and_place_sequence">

            <!-- Step 1: Detect objects -->
            <DetectObjects
                object_class=""
                min_confidence="0.3"
                detections="{all_detections}" />

            <!-- Step 2: Move to home position -->
            <MoveToPose pose="home" />

            <!-- Step 3: Open gripper -->
            <OpenGripper />

            <!-- Step 4: Move to cube pre-grasp pose -->
            <!-- TODO: Extract cube pose from detections[0] -->
            <MoveToPose pose="cube_pre_grasp" />

            <!-- Step 5: Move to cube grasp pose -->
            <MoveToPose pose="cube_grasp" />

            <!-- Step 6: Close gripper to grasp cube -->
            <CloseGripper />

            <!-- Step 7: Lift cube -->
            <MoveToPose pose="cube_lift" />

            <!-- Step 8: Move to crate place position -->
            <MoveToPose pose="crate_place" />

            <!-- Step 9: Open gripper to release -->
            <OpenGripper />

            <!-- Step 10: Return home -->
            <MoveToPose pose="home" />

        </Sequence>
    </BehaviorTree>
</root>