<?xml version="1.0"?>
<root BTCPP_format="4">
    <BehaviorTree ID="SimplePickPlace">
        <Sequence name="pick_place_demo">

            <!-- Verify objects are visible -->
            <DetectObjects
                object_class=""
                min_confidence="0.3"
                detections="{detections}" />

            <!-- Go to home position -->
            <MoveToPose target_pose="home" />

            <!-- Open gripper -->
            <OpenGripper />

            <!-- Move to cube (hardcoded position for Phase 2) -->
            <MoveToPose target_pose="ready" />

            <!-- Close gripper to grasp -->
            <CloseGripper />

            <!-- Lift -->
            <MoveToPose target_pose="home" />

            <!-- Move to place position -->
            <MoveToPose target_pose="ready" />

            <!-- Release -->
            <OpenGripper />

            <!-- Return home -->
            <MoveToPose target_pose="home" />

        </Sequence>
    </BehaviorTree>
</root>