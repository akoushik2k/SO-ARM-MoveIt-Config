<root main_tree_to_execute="RobustPick">
    <BehaviorTree ID="RobustPick">
        <Fallback name="pick_with_recovery">
            <!-- Primary pick sequence -->
            <Sequence name="normal_pick">
                <!-- Detect object -->
                <DetectObjects object_class="cube" output_key="objects" />

                <!-- Compute grasp -->
                <ComputeGraspPose
                    object_id="{objects[0].id}"
                    object_pose="{objects[0].pose}"
                    grasp_output_key="grasp"
                    pre_grasp_output_key="pre_grasp" />

                <!-- Open gripper -->
                <OpenGripper />

                <!-- Execute motion with fallback for replanning -->
                <Fallback name="execute_with_replan">
                    <Sequence name="normal_execution">
                        <MoveToPose target_pose="{pre_grasp}" />
                        <MoveToPose target_pose="{grasp}" />
                    </Sequence>

                    <!-- Recovery: clear octomap and retry -->
                    <Sequence name="replan_sequence">
                        <ClearOctomap />
                        <MoveToPose target_pose="{pre_grasp}" />
                        <MoveToPose target_pose="{grasp}" />
                    </Sequence>
                </Fallback>

                <!-- Close gripper -->
                <CloseGripper />

                <!-- Attach object -->
                <AttachObject object_id="{objects[0].id}" link_name="gripper_link" />
            </Sequence>

            <!-- Recovery: go home and retry from beginning -->
            <Sequence name="full_recovery">
                <GoHome />
                <ClearOctomap />
            </Sequence>
        </Fallback>
    </BehaviorTree>
</root>